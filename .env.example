NODE_ENV=development
HOST=0.0.0.0
PORT=8080
DATABASE_URL=postgres://user:password@host:5432/liftfuel
DATABASE_MAX_CONNECTIONS=5
API_BASE_PATH=/api

# Production public origin configuration.
# SELF_URL is the canonical browser-visible site URL used for auth return_to
# redirects. For this deployed LiftFuel app, it must match the callback origin
# registered with Ideavibes auth for app_jya280-aca0-liftfuel-6e5db6:
# SELF_URL=https://jya280-aca0-liftfuel-6e5db6-bp4af.mctai.app
# ALLOWED_CORS_ORIGIN controls browser API access and should use the same public
# origin, or a comma-separated list that includes it when adding custom domains:
# ALLOWED_CORS_ORIGIN=https://jya280-aca0-liftfuel-6e5db6-bp4af.mctai.app
# Local development may use the localhost values below.
ALLOWED_CORS_ORIGIN=http://localhost:8081
SELF_URL=http://localhost:8080

# Optional frontend override for local/native or explicitly split frontend/API
# hosts. Leave unset in deployed web builds that serve Expo and /api together.
EXPO_PUBLIC_API_BASE_URL=http://localhost:8080/api

IDEAVIBES_AUTH_URL=https://auth.mctai.app
IDEAVIBES_AUTH_APP_TOKEN=app_jya280-aca0-liftfuel-6e5db6
IDEAVIBES_AUTH_JWKS_URL=https://auth.mctai.app/.well-known/jwks.json
# Legacy MCTAI_AUTH_* aliases are still accepted by the backend for compatibility.

# Optional cookie overrides. Usually leave blank: the server uses SameSite=Lax
# for same-origin requests and SameSite=None; Secure when a browser Origin is
# cross-site. Only set a domain when frontend/API share a parent domain and the
# auth service issues cookies for that same domain; never set localhost as a domain.
IDEAVIBES_SESSION_COOKIE_DOMAIN=
IDEAVIBES_SESSION_COOKIE_SAMESITE=
IDEAVIBES_SESSION_COOKIE_SECURE=

IDEAVIBES_EMAIL_URL=
IDEAVIBES_EMAIL_APP_TOKEN=
# Legacy MCTAI_EMAIL_* aliases are still accepted by the backend for compatibility.

OBJECT_STORAGE_ENDPOINT=https://example-object-storage.local
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_BUCKET=liftfuel
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
OBJECT_STORAGE_PREFIX=liftfuel/dev
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
